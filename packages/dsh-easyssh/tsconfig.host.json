{
  // Host-half program (node process side): the mode store, backends, routes,
  // and agent tools over the dsh-ssh engine. SDK types resolve from the
  // @deepseek-ai/* npm packages declared in devDependencies (official NPM
  // SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/fs.ts",
    "src/subprocess.ts",
    "src/core.ts",
    "src/protocol.ts",
    "src/store.ts",
    "src/backend.ts",
    "src/routes.ts",
    "src/tools.ts",
    "src/remote/**/*.ts",
    "src/switch/**/*.ts"
  ]
}
